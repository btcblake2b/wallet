<?xml version="1.0" encoding="utf-8"?>
<!-- PERCHÉ: adaptive icon API 26+. La maschera del launcher ritaglia l'immagine
     (cerchio/squircle): lo sfondo navy viene dal colore, il foreground col mark C4
     (anello+nodo, niente glifo ₿) è in safe zone centrale (~45%), quindi niente tagli. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
