# ============================================================================
# Tooling locale (NON usato dall'app Flutter: per quello vedi mobile/.env)
# Questo file e' SOLO un template committato. Copialo in `.env` (gitignored).
# ============================================================================

# Cloudflare Workers AI - serve a scripts/verify-dod.ps1 (modello typesafe/jev).
# Account ID: dashboard Cloudflare -> Workers AI -> "Account ID" (32 caratteri esadecimali).
CLOUDFLARE_ACCOUNT_ID=
# API token: dashboard Cloudflare -> My Profile -> API Tokens -> permesso "Workers AI: Read".
CLOUDFLARE_API_TOKEN=

# NOTA: typesafe/jev e' un modello TERZO -> si paga con Unified Billing.
# Serve caricare crediti: AI -> AI Gateway -> "Credits Available" -> Manage -> Top-up.
# Senza crediti l'API risponde 402 Payment Required (anche con token valido e piano Free).

# Opzionale: override del modello (default: typesafe/jev).
# JEV_MODEL=typesafe/jev