{
  "name": "nwc-cln-bridge-startos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -rf ./javascript && ncc build startos/index.ts -o ./javascript",
    "check": "tsc --noEmit",
    "prettier": "prettier --write startos"
  },
  "dependencies": {
    "@start9labs/start-sdk": "2.0.9",
    "cln-startos": "github:Start9Labs/cln-startos#next"
  },
  "devDependencies": {
    "@types/node": "^22.1.0",
    "@vercel/ncc": "^0.38.1",
    "prettier": "^3.2.5",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  },
  "overrides": {
    "@start9labs/start-sdk": "$@start9labs/start-sdk"
  }
}
