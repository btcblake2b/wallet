# Bridge (Dart) — artefatti di build locali
bridge/.dart_tool/

# Sentry
mobile/sentry.properties

# Log di debug
firestore-debug.log

# Cloudflare Wrangler (cache locale di login/credenziali — mai versionare)
.wrangler/
