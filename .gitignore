# envied generated files (contenuti offuscati ma decodificabili)
**/env.g.dart

# Android signing
mobile/android/key.properties

# Google services (Firebase — non usato nel fork blake2b)
**/google-services.json
!**/google-services.json.example

# IDE
.continue/
.sixth/
.idea/
*.iml

# rtt cache
.rtt-cache/

# Python (MCP servers locali)
.venv/

# OS
Thumbs.db
.DS_Store
*.apk

